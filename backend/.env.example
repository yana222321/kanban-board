# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kanban_test?schema=public"

# Auth
JWT_SECRET="dev-super-secret-change-me"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Attachments
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES=5242880

# Rate limit (запросов за окно RATE_LIMIT_WINDOW_MS; 0 — отключить)
RATE_LIMIT=300
RATE_LIMIT_WINDOW_MS=60000
